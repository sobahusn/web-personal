# Copy to .env.local for `vercel dev`. In production, set these in
# Vercel > Project > Settings > Environment Variables.
# Never prefix them with VITE_ (that would expose them to the browser).

# Fine-grained personal access token for THIS repository only,
# with "Contents: Read and write" and nothing else.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# The panel login password. Use a long passphrase.
ADMIN_PASSWORD=
# 32+ random characters, used to sign the session cookie.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=
