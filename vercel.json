{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)content'",
  "rewrites": [
    {
      "source": "/articles/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|twitterbot|slackbot|whatsapp|linkedinbot|telegrambot|discordbot|pinterest|embedly|skypeuripreview).*"
        }
      ],
      "destination": "/api/share?slug=:slug"
    },
    {
      "source": "/((?!api/|@vite/|@react-refresh|src/|node_modules/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "framework": "vite"
}
